# TSecBench
# Base URL and token are issued by the platform when you create a local-mode
# scoring run ("开始跑分 → 本地模式").
PLATFORM_MODE=tsec
BENCHMARK_BASE_URL=https://tsecbench.zc.tencent.com
BENCHMARK_TOKEN=
BENCHMARK_NAME=

# Models — DeepSeek is the primary line. Qwen and GLM are optional alternates
# (used only when DEEPSEEK_API_KEY is absent, or via --models).
DEEPSEEK_API_KEY=sk-...
# Optional: extra DeepSeek keys, comma-separated. Concurrent solvers rotate
# over all keys round-robin — multiplies the rate-limit quota without changing
# model behavior. Example: DEEPSEEK_EXTRA_API_KEYS=sk-bbb,sk-ccc
DEEPSEEK_EXTRA_API_KEYS=
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_MODE=chat
GLM_API_KEY=

# Per-challenge wall-clock limit. If a task is not solved within this budget,
# its container is closed, the task is deferred, and the slot moves to the next
# unsolved task.
CHALLENGE_TIME_LIMIT_SECONDS=1800
# Delay between a solver's continuation turns (bump retry).
SOLVER_RETRY_DELAY_SECONDS=2
# When every unsolved task is deferred and nothing is running, auto-clear the
# deferred list after this many idle seconds (unattended runs must not stall).
AUTO_RESUME_IDLE_SECONDS=240
# Rolling retry of deferred challenges: once the window has a free slot and no
# never-tried challenge is left, deferred ones are retried automatically (no
# operator /resume needed). Each gets at most this many spawn attempts before
# it stays deferred until re-enabled (0 = no cap). Plus a cooldown so a
# just-failed task isn't instantly re-spawned into the slot it vacated.
MAX_CHALLENGE_ATTEMPTS=3
DEFER_RETRY_COOLDOWN_SECONDS=120
# Multi-stage penetration (killchain) tasks get a longer wall-clock budget.
KILLCHAIN_TIME_LIMIT_SECONDS=2700
# Multi-flag tasks: withdraw with partial credit if no new flag is accepted
# within this window.
PARTIAL_STALL_SECONDS=600
# Concurrent range containers (hard cap 3, counted by live containers).
MAX_CONCURRENT_CHALLENGES=3
# Per solver-run scratch dir root (run_python workspaces).
CTF_STATE_DIR=.ctf-state

# Total wall-clock budget for the WHOLE run (e.g. Tsecbench v1's published
# 360-minute window = 21600). 0/unset disables this entirely — every
# per-challenge time limit above then behaves exactly as before, with no
# notion of a run-wide deadline. When set, new challenges stop being started
# once too little of the total budget remains (MIN_REMAINING_SECONDS_TO_SPAWN),
# and any new challenge's own time limit is clamped to not exceed what is
# actually left — otherwise the scheduler can keep opening containers that
# have no chance to finish before the platform cuts the run off.
TOTAL_BENCHMARK_BUDGET_SECONDS=0
MIN_REMAINING_SECONDS_TO_SPAWN=300
# VPN-only health endpoint probed before the run starts. Override only if the
# platform changes this address.
VPN_HEALTH_CHECK_URL=http://10.0.100.58

# Allow the run_python local-CPython tool (set false to disable).
ALLOW_LOCAL_EXEC=true
# run_python subprocess escape hatch: the target-lock preamble refuses
# subprocess/os.exec by default (they would escape the network allowlist).
# Set 1 to allow child processes (documented gap; operator decision).
RUN_PYTHON_ALLOW_SUBPROCESS=0

# Opt-in subsystems (both default OFF; see docs/rewrite-plan.md "已拍板").
# 1 = give solvers remember/recall_memory tools (logs/cross-task-memory.jsonl)
CROSS_TASK_MEMORY_ENABLED=0
# 1 = give solvers the record_finding tool (logs/findings-<challenge>.jsonl)
FINDINGS_OUTPUT_ENABLED=0

# TLS verification for the platform client (default on; set false only in a
# corporate MITM environment, with the understood token-exposure tradeoff).
PLATFORM_TLS_VERIFY=true
